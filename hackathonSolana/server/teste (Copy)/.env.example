# public address that receives payments
RECIPIENT_PUBKEY=BsoAownwuf8JJbtzB9Rr1YL1Y19K9ko6kPRPYMzt7f2e

# base58-encoded secret key for RECIPIENT_PUBKEY, only required to send refunds.
