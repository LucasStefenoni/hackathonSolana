RPC_URL=https://api.devnet.solana.com

# public address that receives payments
RECIPIENT_PUBKEY=BsoAownwuf8JJbtzB9Rr1YL1Y19K9ko6kPRPYMzt7f2e

# base58-encoded secret key for RECIPIENT_PUBKEY, only required to send refunds.
# NEVER commit the real value. leave blank to disable refunds on this machine.
RECIPIENT_SECRET_KEY=

LAMPORTS_PER_ML=200

LABEL=Bebedouro pay-as-you-consume

# public URL wallets hit to fetch/build the payment transaction - must be a
# real public tunnel (ngrok, cloudflared) to this machine's port 5000, e.g.
# https://abcd1234.ngrok-free.app/pay
PUBLIC_SERVER_URL=https://127.0.0.1:5000/pay

DEBUG=1

# --- robustness knobs (all optional; defaults shown) ---
# commitment level for reads and for accepting a payment before pouring
RPC_COMMITMENT=confirmed
# HTTP retry budget for a single RPC call (transient network / 429 / 5xx)
RPC_MAX_RETRIES=4
# stop waiting for the buyer to pay after this many seconds, then free the kiosk
PAYMENT_TIMEOUT_S=180
# drop unpaid orders from memory after this long
ORDER_TTL_S=600
# worst-case flow rate expected from the meter - sets the dispense safety cutoff
MIN_FLOW_ML_S=5
# extra slack on top of the computed dispense deadline
DISPENSE_GRACE_S=10
# no pulse for this long mid-pour => stalled sensor / no water, cut the valve
STALL_S=4
# durable log of refunds owed but not yet confirmed on-chain (auto-retried on start)
# REFUND_JOURNAL=./refunds.jsonl

